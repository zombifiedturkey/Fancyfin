# TMDB, through this server so the API key never reaches the browser. Read-only, and only the
# charts the app uses. Filled in at container start by docker/10-fancyfin-proxy.sh.
location /tmdb/ {
    limit_except GET { deny all; }
    if ($uri !~ "^/tmdb/(trending|movie|tv|configuration)(/|$)") { return 404; }

    # A variable host means nginx looks it up when asked, not at start-up, so a DNS hiccup
    # can't stop the container from booting.
    resolver __RESOLVER__ valid=300s ipv6=off;
    set $tmdb_host api.themoviedb.org;

    rewrite ^/tmdb/(.*)$ /3/$1__REWRITE_ARGS__ break;
    proxy_pass https://$tmdb_host;
    proxy_ssl_server_name on;
    proxy_ssl_name api.themoviedb.org;
    proxy_set_header Host api.themoviedb.org;
    proxy_set_header Accept "application/json";
    __AUTH__

    proxy_connect_timeout 10s;
    proxy_read_timeout 20s;

    # The charts change slowly. Cache them so a page load doesn't hit TMDB every time.
    proxy_cache tmdb;
    proxy_cache_valid 200 30m;
    proxy_cache_valid any 1m;
    proxy_cache_key "$request_uri";
    add_header Cache-Control "private, max-age=600";
}
