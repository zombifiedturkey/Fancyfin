# Radarr and Sonarr are only for Jellyfin administrators. Before a request reaches them, nginx asks
# Jellyfin whether the caller's token may open an admin-only page. A normal user's token gets a 403
# there, so the request is refused. Filled in at container start by docker/10-fancyfin-proxy.sh.
resolver __RESOLVER__ valid=300s ipv6=off;

location = /_fancyfin/admin {
    internal;
    proxy_pass __JELLYFIN_URL__/Auth/Keys;
    proxy_http_version 1.1;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Emby-Token $http_x_emby_token;
    proxy_connect_timeout 10s;
    proxy_read_timeout 15s;
}
