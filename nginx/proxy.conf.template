# Jellyfin API, streams, images and websocket, same-origin so there is no CORS.
# The trailing slash on proxy_pass strips the /api prefix.
location /api/ {
    proxy_pass __JELLYFIN_URL__/;
    proxy_http_version 1.1;

    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Fail fast when the address is wrong instead of hanging.
    proxy_connect_timeout 10s;

    # Video streams and HLS segments: don't buffer, allow range requests through.
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    client_max_body_size 0;
}
