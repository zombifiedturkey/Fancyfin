# Copy to .env.local and set the address of your Jellyfin server.
# Used by the Vite dev proxy (pnpm dev / pnpm preview).
JELLYFIN_URL=http://192.168.1.50:8096

# TMDB, Radarr and Sonarr are connected in Settings, not here. In dev, start the small settings service in a
# second terminal with `pnpm dev:server`; it saves to ./.config.
