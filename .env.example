# Copy to .env.local and set the address of your Jellyfin server.
# Used by the Vite dev proxy (pnpm dev / pnpm preview).
JELLYFIN_URL=http://192.168.1.50:8096

# Optional. A TMDB API key or read access token, for the "popular right now" banner.
# Used by the Vite dev proxy only; it never reaches the browser. Put the real one in .env.local.
TMDB_API_KEY=

# Optional. Radarr and/or Sonarr, for the "Add to Radarr / Sonarr" button on titles you don't have.
# Dev proxy only; the key never reaches the browser. Put the real ones in .env.local.
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
